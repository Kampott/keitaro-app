  {
    "value": "update_offers_by_report",
    "tooltip": null,
    "modes": {
      "accept": "IS",
      "reject": "IS NOT"
    },
    "group": "filters.groups.other",
    "template": "<div style=\"font-family: Arial, sans-serif; line-height: 1.5; max-width: 800px; margin: 20px auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px; background-color: #f9f9f9;\">\r\n    <div style=\"display: flex; flex-wrap: wrap; gap: 20px;\">\r\n        <div style=\"flex: 1 1 48%; min-width: 300px;\">     \r\n          <div style=\"margin-bottom: 15px;\">\r\n              <label for=\"offer_group_ids\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">ID групп офферов*:</label>\r\n              <input \r\n                  id=\"offer_group_ids\"\r\n                  type=\"text\"\r\n                  ng-model=\"filter.payload.offer_group_ids\"\r\n                  placeholder=\"Например 1422, 1423\"\r\n                  style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; height: 42px;\"\r\n              />\r\n          </div>        \r\n            <div style=\"margin-bottom: 15px;\">\r\n                <label for=\"metric\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">Какую метрику анализировать:</label>\r\n                <select \r\n                    id=\"metric\"\r\n                    ng-model=\"filter.payload.metric\"\r\n                    ng-init=\"filter.payload.metric || (filter.payload.metric='crs')\"\r\n                    style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; height: 42px;\"\r\n                >\r\n                    <option value=\"roi_confirmed\">ROI (подтвержденный)</option>\r\n                    <option value=\"cr\">CR</option>\r\n                    <option value=\"crs\">CRs</option>\r\n                </select>\r\n            </div>\r\n\r\n            <div style=\"margin-bottom: 15px;\">\r\n                <label for=\"statistics\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">Охват статистики:</label>\r\n                <select \r\n                    id=\"statistics\"\r\n                    ng-model=\"filter.payload.statistics\"\r\n                    ng-init=\"filter.payload.statistics || (filter.payload.statistics='creative')\"\r\n                    style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; height: 42px;\"\r\n                >\r\n                    <option value=\"all\">Группы офферов</option>\r\n                    <option value=\"creative\">Группы офферов + креатив</option>\r\n                </select>\r\n            </div>\r\n        </div>\r\n\r\n        <div style=\"flex: 1 1 48%; min-width: 300px;\">\r\n            <div style=\"margin-bottom: 15px;\">\r\n                <label for=\"offer_quantity\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">Кол-во офферов:</label>\r\n                <input \r\n                    type=\"range\" \r\n                    id=\"offer_quantity\"\r\n                    ng-model=\"filter.payload.offer_quantity\"\r\n                    ng-init=\"filter.payload.offer_quantity || (filter.payload.offer_quantity=5)\"\r\n                    min=\"1\" \r\n                    max=\"5\" \r\n                    step=\"1\"\r\n                    style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;\"\r\n                />\r\n                <span>До {{filter.payload.offer_quantity}} офферов</span>\r\n            </div>        \r\n            <div style=\"margin-bottom: 15px;\">\r\n                <label for=\"days\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">Дни статистики:</label>\r\n                <input \r\n                    type=\"range\" \r\n                    id=\"days\"\r\n                    ng-model=\"filter.payload.days\"\r\n                    ng-init=\"filter.payload.days || (filter.payload.days=7)\"\r\n                    min=\"1\" \r\n                    max=\"7\" \r\n                    step=\"1\"\r\n                    style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;\"\r\n                />\r\n                <span>{{filter.payload.days}} дней</span>\r\n            </div>\r\n          <div style=\"margin-bottom: 15px;\"> \r\n                <label \r\n                    style=\"display: block; font-weight: bold; margin-bottom: 5px;\"\r\n                > \r\n                <span>Исключать некоторые источники</span> \r\n                <input \r\n                    type=\"checkbox\" \r\n                    ng-model=\"filter.payload.ignore_ts\" \r\n                    ng-init=\"filter.payload.ignore_ts === undefined ? (filter.payload.ignore_ts=true) : filter.payload.ignore_ts\" \r\n                    style=\"margin-left: 10px;\" \r\n                /> \r\n                </label> \r\n          </div>\r\n\r\n          <div style=\"margin-bottom: 15px;\" ng-show=\"filter.payload.ignore_ts\">\r\n              <label for=\"ignored_ts_ids\" style=\"display: block; font-weight: bold; margin-bottom: 5px;\">ID игнорируемых источников:</label>\r\n              <input \r\n                  id=\"ignored_ts_ids\"\r\n                  type=\"text\"\r\n                  ng-model=\"filter.payload.ignored_ts_ids\"\r\n                  placeholder=\"Например 70, 155\"\r\n                  ng-init=\"filter.payload.ignored_ts_ids || (filter.payload.ignored_ts_ids='70,155,154,189')\"\r\n                  style=\"width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; height: 42px;\"\r\n              />\r\n          </div>\r\n        </div>\r\n    </div>\r\n</div>",
    "defaults": null
  }
]
