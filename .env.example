# Для локальной разработки. Для любого общего развёртывания: APP_ENV=production и пароль ниже.
APP_ENV=development
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Адрес трекера без /admin и без /admin_api/v1, например https://tracker.example.com
KEITARO_BASE_URL=
KEITARO_API_KEY=

# Compose собирает DATABASE_URL сам; эта строка нужна только для запуска backend вне Docker.
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@localhost:5433/adrobot
